# URL de conexión PostgreSQL
DATABASE_URL=postgresql+psycopg2://usuario:contraseña@localhost:5432/buscador_personas

# Orígenes permitidos separados por coma (dejar vacío para usar defaults de desarrollo)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# API Key para consulta RUC (peruapi.com) - obtener gratis en https://peruapi.com/registro
RUC_API_KEY=

# API keys para acceder a la API (separadas por coma). Dejar vacío = acceso abierto (solo desarrollo)
API_KEYS=

# Secreto para tokens de sesión del frontend (se auto-genera a partir de API_KEYS si no se especifica)
# FRONTEND_TOKEN_SECRET=

# TTL del token de sesión del frontend en segundos (default: 3600 = 1 hora)
# FRONTEND_TOKEN_TTL=3600

# Límites de rate limiting (por IP, en ventana de segundos)
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW=60
# SEARCH_RATE_LIMIT_MAX=60
# SEARCH_RATE_LIMIT_WINDOW=60

# TTLs de caché en segundos
# DNI_CACHE_TTL=300
# BUSCAR_CACHE_TTL=60
# RUC_CACHE_TTL=3600
