# Ejemplo para desarrollo local. Para levantar el stack con Docker copia
# mejor ../.env.example (en la raíz del repositorio) a .env.
#
# ── Base de datos ───────────────────────────────────────────────────────
# En Docker usa el host "db"; en local usa localhost.
DATABASE_URL=postgresql+psycopg2://buscador:CAMBIAR_PASSWORD@db:5432/buscador_personas

# ── Entorno y secretos ──────────────────────────────────────────────────
# development | production | test
APP_ENV=development

# Obligatorio en producción. Genera uno con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_HOURS=8
JWT_COOKIE_NAME=bp_access

# APP_ENV=production exige HTTPS (terminación TLS en el proxy externo):
# ahí COOKIE_SECURE debe ser true. Este ejemplo es de desarrollo, por HTTP,
# por eso se deja en false; el navegador no envía la cookie sin Secure en HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ── Acceso ──────────────────────────────────────────────────────────────
# API keys de solo lectura para integraciones (separadas por coma).
API_KEYS=
# El acceso abierto sin credenciales solo se permite fuera de producción.
ALLOW_OPEN_ACCESS=true
# Orígenes permitidos para CORS. Vacío = mismo origen.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Proxy / IP real ─────────────────────────────────────────────────────
# Actívalo solo si el backend no está expuesto directamente y el proxy
# reenvía X-Forwarded-For / X-Real-IP.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=

# ── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
SEARCH_RATE_LIMIT_MAX=60
SEARCH_RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=300

# ── Caché ───────────────────────────────────────────────────────────────
# Redis es opcional; sin REDIS_URL se usa caché en memoria.
REDIS_URL=
CACHE_PREFIX=buscador
DNI_CACHE_TTL=300
BUSCAR_CACHE_TTL=60
RUC_CACHE_TTL=3600
ARBOL_CACHE_TTL=600
NEGATIVE_CACHE_TTL=30

# ── RUC / SUNAT ─────────────────────────────────────────────────────────
RUC_API_KEY=
RUC_API_BASE=https://peruapi.com/api

# ── Búsqueda familiar ───────────────────────────────────────────────────
FAMILIA_CANDIDATOS=300
FAMILIA_LIMITE_DEFAULT=50
FAMILIA_LIMITE_MAX=200
FAMILIA_UMBRAL_ALTA=70
FAMILIA_UMBRAL_MEDIA=50
# true solo para inspeccionar indicios no confirmados en el árbol.
FAMILIA_INCLUIR_PROBABLES=false
BUSCAR_CANDIDATOS=300

# ── Administrador inicial ───────────────────────────────────────────────
# Se crea al arrancar si no existe. En producción debes reemplazar el valor
# de ejemplo antes de levantar el servicio.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
