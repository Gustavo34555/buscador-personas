# ── Docker Compose (producción) ─────────────────────────────────────────
# Copia este archivo a .env y reemplaza todos los valores de ejemplo.
# La aplicación rechaza el arranque en producción si detecta contraseñas
# de ejemplo o un JWT_SECRET inseguro.
APP_ENV=production

# Base de datos del contenedor PostgreSQL.
POSTGRES_DB=buscador_personas
POSTGRES_USER=buscador
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

# Cadena de conexión usada por el backend dentro de la red de Docker.
DATABASE_URL=postgresql+psycopg2://buscador:CAMBIAR_PASSWORD@db:5432/buscador_personas

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_HOURS=8
JWT_COOKIE_NAME=bp_access

# true solo cuando el frontend se sirve por HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Acceso y CORS.
ALLOW_OPEN_ACCESS=false
ALLOWED_ORIGINS=
API_KEYS=
RUC_API_KEY=

# Nginx es el único punto de entrada publicado.
FRONTEND_PORT=8080

# Administrador inicial. Cambia la contraseña después del primer login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# Caché opcional compartida entre workers.
REDIS_URL=
CACHE_PREFIX=buscador
