# ── Docker Compose (producción) ─────────────────────────────────────────
# Copia este archivo a .env y reemplaza todos los valores de ejemplo.
# La aplicación rechaza el arranque en producción si detecta contraseñas
# de ejemplo o un JWT_SECRET inseguro.
#
# APP_ENV=production exige un despliegue por HTTPS: la terminación TLS se
# hace en el proxy externo (Caddy, Traefik, ALB, ...) y COOKIE_SECURE debe
# permanecer en true; de lo contrario el navegador no enviará la cookie.
APP_ENV=production

# Base de datos del contenedor PostgreSQL.
POSTGRES_DB=buscador_personas
POSTGRES_USER=buscador
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

# Cadena de conexión usada por los comandos locales (psql, migraciones).
# IMPORTANTE: la contraseña debe ser exactamente la misma que
# POSTGRES_PASSWORD. En Docker Compose, el backend NO usa este valor:
# DATABASE_URL se reconstruye desde POSTGRES_USER/PASSWORD/DB para que no
# puedan divergir en silencio. `make check-env` valida que coincidan.
# Evita caracteres reservados de URL (@ / : # ?) en la contraseña o codifícalos.
DATABASE_URL=postgresql+psycopg2://buscador:CAMBIAR_PASSWORD@db:5432/buscador_personas

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_HOURS=8
JWT_COOKIE_NAME=bp_access

# true es obligatorio en producción (HTTPS). Usa false SOLO para probar por
# HTTP en localhost; con HTTPS, una cookie sin el atributo Secure no se envía.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Acceso y CORS.
ALLOW_OPEN_ACCESS=false
ALLOWED_ORIGINS=
API_KEYS=
RUC_API_KEY=

# Nginx es el único punto de entrada publicado.
FRONTEND_PORT=8080

# Confianza de proxy/IP real (el backend no publica su puerto).
# Nginx tiene la IP fija 172.28.0.10 en docker-compose.yml; ajusta estos
# valores si cambias la subred del compose.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXIES=172.28.0.10

# Administrador inicial. Cambia la contraseña después del primer login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# Caché compartida. El compose levanta Redis 7 y usa esta URL por defecto;
# en un arranque local sin Redis, deja el valor vacío para usar caché en memoria.
REDIS_URL=redis://redis:6379/0
CACHE_PREFIX=buscador
